@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@using System.ComponentModel.DataAnnotations

<PageTitle>Usuarios — VisitaPDV Admin</PageTitle>

<!-- Header Principal -->
<div class="card vpdv-card border-0 shadow-sm p-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-people text-primary"></i>
                <span>Gestión de Usuarios</span>
            </h4>
            <p class="text-secondary small mb-0">Administra cuentas de acceso, roles corporativos, zonas asignadas e intentos fallidos de autenticación</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 shadow-sm" style="min-height: 40px;" @onclick="OpenCreateModal">
                <i class="bi bi-person-plus"></i>
                <span>Nuevo usuario</span>
            </button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="min-height: 40px; border-color: var(--color-border);" @onclick="LoadDataAsync" title="Actualizar datos">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Actualizar</span>
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <div>@_error</div>
    </div>
}

<!-- Card Tabla de Usuarios -->
<div class="card vpdv-card border-0 shadow-sm">
    <!-- Barra Coherente de Búsqueda y Filtros -->
    <div class="card-header bg-white py-3" style="border-bottom: 1px solid var(--color-border);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge text-primary fs-5"></i>
                <span class="fw-bold text-dark fs-6">Usuarios Registrados</span>
                <span class="badge badge-soft-primary px-2 py-1 ms-1">
                    @Filtrados.Count() usuario(s)
                </span>
            </div>

            <!-- Controles de Filtros: Búsqueda, Rol, Zona y Estado -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Búsqueda con indicación explícita -->
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: var(--color-border);">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" 
                           style="border-color: var(--color-border);"
                           placeholder="Buscar por nombre, usuario o correo..." 
                           @bind="_filtro" @bind:event="oninput" 
                           aria-label="Buscar por nombre, usuario o correo" />
                    @if (!string.IsNullOrWhiteSpace(_filtro))
                    {
                        <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => _filtro = string.Empty" title="Limpiar texto">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                <!-- Filtro por Rol -->
                <select class="form-select form-select-sm" style="width: 150px; border-color: var(--color-border);" @bind="_filterRol" aria-label="Filtrar por rol">
                    <option value="">Todos los roles</option>
                    @if (_roles is not null)
                    {
                        @foreach (var r in _roles)
                        {
                            <option value="@r.Nombre">@r.Nombre</option>
                        }
                    }
                </select>

                <!-- Filtro por Estado -->
                <select class="form-select form-select-sm" style="width: 140px; border-color: var(--color-border);" @bind="_filterEstado" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>

                @if (!string.IsNullOrWhiteSpace(_filtro) || !string.IsNullOrWhiteSpace(_filterRol) || !string.IsNullOrWhiteSpace(_filterEstado))
                {
                    <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="min-height: 36px;" @onclick="LimpiarFiltros" title="Limpiar búsqueda y filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Limpiar búsqueda</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Cuerpo de la Tabla -->
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="d-flex flex-column justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="text-secondary small">Cargando usuarios del sistema...</div>
            </div>
        }
        else if (_usuarios is null)
        {
            <div class="p-4">
                <div class="alert alert-warning mb-0">No se pudieron cargar los usuarios.</div>
            </div>
        }
        else if (!Filtrados.Any())
        {
            <div class="p-4">
                <EmptyState Icon="bi-person-x"
                            Titulo="No se encontraron usuarios"
                            Mensaje="No hay usuarios que coincidan con los criterios de búsqueda o filtros seleccionados."
                            BotonTexto="Limpiar búsqueda"
                            BotonIcono="bi-arrow-counterclockwise"
                            OnAccion="LimpiarFiltros" />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small">
                            <th class="ps-3" style="min-width: 180px;">Nombre completo</th>
                            <th style="width: 140px;">Usuario</th>
                            <th style="min-width: 220px;">Correo electrónico</th>
                            <th style="width: 130px;">Rol</th>
                            <th style="width: 120px;">Zona</th>
                            <th class="text-center" style="width: 110px;">Estado</th>
                            <th style="width: 140px;">Último acceso</th>
                            <th class="text-center" style="width: 130px;">Intentos fallidos</th>
                            <th class="pe-3 text-end" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Filtrados)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">@u.Nombre @u.Apellido</td>
                                <td class="text-secondary font-monospace small">@@@u.Username</td>
                                <td class="small text-secondary">@u.Email</td>
                                <td>
                                    <span class="badge @(u.Rol switch {
                                        "Administrador" => "badge-soft-primary",
                                        "Supervisor" => "badge-soft-info",
                                        _ => "bg-light text-dark border"
                                    }) rounded-pill px-2.5 py-1.5">
                                        @u.Rol
                                    </span>
                                </td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(u.ZonaId) ? "—" : u.ZonaId)</td>
                                <td class="text-center">
                                    <span class="badge @(u.Activo ? "badge-soft-success" : "badge-soft-danger") rounded-pill px-3 py-1.5">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i>
                                        @(u.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="small text-muted text-nowrap">
                                    @(u.UltimoLogin.HasValue ? u.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                </td>
                                <td class="text-center @(u.IntentosFallidos > 0 ? "text-danger fw-bold" : "text-muted")">
                                    @u.IntentosFallidos
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span>Acciones</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="border-radius: 8px;">
                                            <li>
                                                <button class="dropdown-item d-flex align-items-center gap-2 py-2" @onclick="() => OpenEditModal(u)">
                                                    <i class="bi bi-pencil text-primary"></i>
                                                    <span>Editar usuario</span>
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item d-flex align-items-center gap-2 py-2" @onclick="() => OpenPasswordModal(u)">
                                                    <i class="bi bi-key text-warning"></i>
                                                    <span>Restablecer contraseña</span>
                                                </button>
                                            </li>
                                            @if (u.IntentosFallidos > 0)
                                            {
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" @onclick="() => ResetIntentos(u)">
                                                        <i class="bi bi-arrow-counterclockwise text-info"></i>
                                                        <span>Resetear intentos fallidos</span>
                                                    </button>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <button class="dropdown-item d-flex align-items-center gap-2 py-2 @(u.Activo ? "text-danger" : "text-success")" @onclick="() => OpenToggleConfirmModal(u)">
                                                    <i class="bi bi-@(u.Activo ? "person-slash" : "person-check")"></i>
                                                    <span>@(u.Activo ? "Desactivar usuario" : "Activar usuario")</span>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Confirmación de Desactivación / Activación -->
@if (_toggleConfirmUser != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(15, 23, 42, 0.6); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header @(_toggleConfirmUser.Activo ? "bg-danger text-white" : "bg-success text-white") py-3">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi @(_toggleConfirmUser.Activo ? "bi-person-slash" : "bi-person-check")"></i>
                        <span>@(_toggleConfirmUser.Activo ? "Confirmar desactivación de usuario" : "Confirmar activación de usuario")</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="() => _toggleConfirmUser = null"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        ¿Está seguro de que desea @(_toggleConfirmUser.Activo ? "desactivar" : "activar") la cuenta del usuario:
                    </p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark fs-6">@_toggleConfirmUser.Nombre @_toggleConfirmUser.Apellido</div>
                        <div class="text-secondary small font-monospace">Usuario: @@@_toggleConfirmUser.Username</div>
                        <div class="text-secondary small">Correo: @_toggleConfirmUser.Email</div>
                        <div class="text-secondary small">Rol actual: @_toggleConfirmUser.Rol</div>
                    </div>
                    @if (_toggleConfirmUser.Activo)
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Consecuencia:</strong> El usuario perderá de inmediato el acceso al panel web y a la app móvil hasta que sea reactivado.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Consecuencia:</strong> El usuario podrá volver a iniciar sesión y ejecutar sus funciones con sus credenciales habituales.
                        </div>
                    }
                </div>
                <div class="modal-footer border-top py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _toggleConfirmUser = null">Cancelar</button>
                    <button type="button" class="btn @(_toggleConfirmUser.Activo ? "btn-danger" : "btn-success") px-3" disabled="@_saving" @onclick="ConfirmarToggleActivoAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>@(_toggleConfirmUser.Activo ? "Confirmar y desactivar" : "Confirmar y activar")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Formulario Usuario (Crear / Editar) -->
@if (_showUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(15, 23, 42, 0.6); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center badge-soft-primary text-primary">
                            <i class="bi bi-@(string.IsNullOrEmpty(_editingUserId) ? "person-plus" : "pencil-square") fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">
                                @(string.IsNullOrEmpty(_editingUserId) ? "Crear Nuevo Usuario" : "Editar Usuario")
                            </h5>
                            <span class="text-secondary small">Información de cuenta y perfil de acceso</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseUserModal" aria-label="Cerrar"></button>
                </div>
                <EditForm Model="_userForm" OnValidSubmit="SaveUserAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(_modalError))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center mb-3">
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-6"></i> @_modalError
                            </div>
                        }
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">Nombre</label>
                                <InputText class="form-control" @bind-Value="_userForm.Nombre" placeholder="Nombre" />
                                <ValidationMessage For="() => _userForm.Nombre" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">Apellido</label>
                                <InputText class="form-control" @bind-Value="_userForm.Apellido" placeholder="Apellido" />
                                <ValidationMessage For="() => _userForm.Apellido" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">Correo electrónico</label>
                                <InputText class="form-control" type="email" @bind-Value="_userForm.Email" placeholder="correo@visitapdv.com" />
                                <ValidationMessage For="() => _userForm.Email" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">Usuario @(!string.IsNullOrEmpty(_editingUserId) ? "(No editable)" : "")</label>
                                <InputText class="form-control bg-light" @bind-Value="_userForm.Username" placeholder="username" disabled="@(!string.IsNullOrEmpty(_editingUserId))" />
                                <ValidationMessage For="() => _userForm.Username" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">Rol corporativo</label>
                                <InputSelect class="form-select" @bind-Value="_userForm.Rol">
                                    <option value="">Seleccione rol...</option>
                                    @if (_roles is not null)
                                    {
                                        @foreach (var r in _roles)
                                        {
                                            <option value="@r.Nombre">@r.Nombre</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="Visitador">Visitador</option>
                                        <option value="Supervisor">Supervisor</option>
                                        <option value="Administrador">Administrador</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _userForm.Rol" class="text-danger small" />
                            </div>
                            
                            @if (string.IsNullOrEmpty(_editingUserId))
                            {
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-muted mb-1">Contraseña inicial</label>
                                    <InputText class="form-control" type="password" @bind-Value="_userForm.Password" placeholder="Contraseña de acceso" />
                                    <ValidationMessage For="() => _userForm.Password" class="text-danger small" />
                                    <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                        Mínimo 8 caracteres, al menos una mayúscula, una minúscula y un número.
                                    </div>
                                </div>
                            }
                            
                            <div class="col-12">
                                <label class="form-label small fw-semibold text-muted mb-1">Zona asignada (Opcional)</label>
                                <InputText class="form-control" @bind-Value="_userForm.ZonaId" placeholder="Ej. Norte, Sur, Centro" />
                                <ValidationMessage For="() => _userForm.ZonaId" class="text-danger small" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="CloseUserModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            <span>@(string.IsNullOrEmpty(_editingUserId) ? "Crear usuario" : "Guardar cambios")</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Modal Cambiar Contraseña -->
@if (_showPasswordModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(15, 23, 42, 0.6); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 420px;">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center badge-soft-warning text-warning">
                            <i class="bi bi-key-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">Restablecer Contraseña</h5>
                            <span class="text-secondary small">Actualización de credencial de acceso</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="ClosePasswordModal" aria-label="Cerrar"></button>
                </div>
                <EditForm Model="_passwordForm" OnValidSubmit="SavePasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(_modalError))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center mb-3">
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-6"></i> @_modalError
                            </div>
                        }
                        
                        <div class="mb-3 p-3 bg-light rounded-3 text-center border">
                            <span class="text-muted small d-block">Cuenta de usuario afectada:</span>
                            <span class="fw-bold text-dark fs-6">@_selectedUsuario?.Nombre @_selectedUsuario?.Apellido</span>
                            <span class="text-muted d-block small font-monospace">@@@_selectedUsuario?.Username</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted mb-1">Nueva contraseña</label>
                            <InputText class="form-control" type="password" @bind-Value="_passwordForm.Password" placeholder="Nueva contraseña" />
                            <ValidationMessage For="() => _passwordForm.Password" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted mb-1">Confirmar contraseña</label>
                            <InputText class="form-control" type="password" @bind-Value="_passwordForm.ConfirmPassword" placeholder="Confirmar contraseña" />
                            <ValidationMessage For="() => _passwordForm.ConfirmPassword" class="text-danger small" />
                        </div>
                        
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            Mínimo 8 caracteres, al menos una mayúscula, una minúscula y un número.
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="ClosePasswordModal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            <span>Actualizar contraseña</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show align-items-center text-white bg-success border-0 shadow-lg" role="alert">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@_mensaje</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => _mensaje = null"></button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] ApiClient Api { get; set; } = default!;

    private IEnumerable<UsuarioModel>? _usuarios;
    private IEnumerable<RolModel>? _roles;
    private string _filtro = string.Empty;
    private string _filterRol = string.Empty;
    private string _filterEstado = string.Empty;
    private bool _loading;
    private string? _mensaje;
    private string? _error;

    // Modals state
    private bool _showUserModal;
    private bool _showPasswordModal;
    private bool _saving;
    private string? _modalError;
    private string? _editingUserId;
    private UsuarioModel? _selectedUsuario;
    private UsuarioModel? _toggleConfirmUser;

    private UserForm _userForm = new();
    private PasswordForm _passwordForm = new();

    private IEnumerable<UsuarioModel> Filtrados => _usuarios?
        .Where(u => 
            (string.IsNullOrWhiteSpace(_filtro) ||
             u.Nombre.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
             u.Apellido.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
             u.Username.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
             u.Email.Contains(_filtro, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_filterRol) || string.Equals(u.Rol, _filterRol, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_filterEstado) || 
             (_filterEstado == "activo" && u.Activo) || 
             (_filterEstado == "inactivo" && !u.Activo))
        ) ?? [];

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;
        await LoadDataAsync();
        _loading = false;
    }

    private async Task LoadDataAsync()
    {
        var result = await Api.GetUsuariosResultAsync();
        _usuarios = result.Data;
        _error = result.ErrorMessage;

        var rolesResult = await Api.GetRolesResultAsync();
        _roles = rolesResult.Data;
    }

    private void LimpiarFiltros()
    {
        _filtro = string.Empty;
        _filterRol = string.Empty;
        _filterEstado = string.Empty;
    }

    private void OpenToggleConfirmModal(UsuarioModel u)
    {
        _toggleConfirmUser = u;
    }

    private async Task ConfirmarToggleActivoAsync()
    {
        if (_toggleConfirmUser == null) return;
        _saving = true;
        var ok = await Api.ToggleUsuarioActivoAsync(_toggleConfirmUser.Id, !_toggleConfirmUser.Activo);
        _saving = false;
        if (ok)
        {
            _mensaje = $"Usuario '{_toggleConfirmUser.Username}' {(!_toggleConfirmUser.Activo ? "activado" : "desactivado")} exitosamente.";
            _toggleConfirmUser = null;
            await LoadDataAsync();
        }
    }

    private async Task ResetIntentos(UsuarioModel u)
    {
        var ok = await Api.ResetIntentosFallidosAsync(u.Id);
        if (ok)
        {
            _mensaje = $"Intentos fallidos de '{u.Username}' reseteados a 0.";
            await LoadDataAsync();
        }
    }

    // Modal Control: User
    private void OpenCreateModal()
    {
        _editingUserId = null;
        _userForm = new UserForm();
        _modalError = null;
        _showUserModal = true;
    }

    private void OpenEditModal(UsuarioModel u)
    {
        _editingUserId = u.Id;
        _userForm = new UserForm
        {
            Nombre = u.Nombre,
            Apellido = u.Apellido,
            Email = u.Email,
            Username = u.Username,
            Rol = u.Rol,
            ZonaId = u.ZonaId
        };
        _modalError = null;
        _showUserModal = true;
    }

    private void CloseUserModal()
    {
        _showUserModal = false;
        _modalError = null;
    }

    private async Task SaveUserAsync()
    {
        _saving = true;
        _modalError = null;

        try
        {
            if (string.IsNullOrEmpty(_editingUserId))
            {
                if (string.IsNullOrWhiteSpace(_userForm.Password))
                {
                    _modalError = "La contraseña es obligatoria para un usuario nuevo.";
                    _saving = false;
                    return;
                }
                
                var createModel = new CreateUsuarioModel(
                    _userForm.Nombre,
                    _userForm.Apellido,
                    _userForm.Email,
                    _userForm.Username,
                    _userForm.Password,
                    _userForm.Rol,
                    _userForm.ZonaId
                );

                var result = await Api.CreateUsuarioAsync(createModel);
                if (result.Success)
                {
                    _mensaje = "Usuario creado exitosamente.";
                    _showUserModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    _modalError = result.ErrorMessage;
                }
            }
            else
            {
                var updateModel = new UpdateUsuarioModel(
                    _userForm.Nombre,
                    _userForm.Apellido,
                    _userForm.Email,
                    _userForm.Username,
                    _userForm.Rol,
                    _userForm.ZonaId
                );

                var result = await Api.UpdateUsuarioAsync(_editingUserId, updateModel);
                if (result.Success)
                {
                    _mensaje = "Usuario actualizado exitosamente.";
                    _showUserModal = false;
                    await LoadDataAsync();
                }
                else
                {
                    _modalError = result.ErrorMessage;
                }
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // Modal Control: Password
    private void OpenPasswordModal(UsuarioModel u)
    {
        _selectedUsuario = u;
        _passwordForm = new PasswordForm();
        _modalError = null;
        _showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        _showPasswordModal = false;
        _selectedUsuario = null;
        _modalError = null;
    }

    private async Task SavePasswordAsync()
    {
        if (_selectedUsuario is null) return;
        _saving = true;
        _modalError = null;

        try
        {
            var model = new CambiarPasswordModel(_passwordForm.Password);
            var result = await Api.CambiarPasswordAsync(_selectedUsuario.Id, model);
            if (result.Success)
            {
                _mensaje = $"Contraseña de '{_selectedUsuario.Username}' actualizada correctamente.";
                _showPasswordModal = false;
                _selectedUsuario = null;
                await LoadDataAsync();
            }
            else
            {
                _modalError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class UserForm
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El apellido es obligatorio")]
        [StringLength(100, ErrorMessage = "El apellido no puede superar los 100 caracteres")]
        public string Apellido { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo electrónico es obligatorio")]
        [EmailAddress(ErrorMessage = "El formato de correo no es válido")]
        [StringLength(255, ErrorMessage = "El correo no puede superar los 255 caracteres")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "El usuario es obligatorio")]
        [StringLength(100, ErrorMessage = "El usuario no puede superar los 100 caracteres")]
        [RegularExpression(@"^[a-zA-Z0-9_\-\.]+$", ErrorMessage = "Solo se permiten letras, números, guiones, puntos o guiones bajos")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "El rol es obligatorio")]
        public string Rol { get; set; } = string.Empty;

        public string? Password { get; set; }

        public string? ZonaId { get; set; }
    }

    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$", ErrorMessage = "La contraseña debe contener al menos una mayúscula, una minúscula y un número")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe confirmar la contraseña")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
