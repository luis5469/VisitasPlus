@page "/asignaciones"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations

<PageTitle>Agenda de Visitas — VisitaPDV Admin</PageTitle>

<!-- Header Principal -->
<div class="card vpdv-card border-0 shadow-sm p-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-calendar-check text-primary"></i>
                <span>Agenda de Visitas</span>
            </h4>
            <p class="text-secondary small mb-0">Planificación de visitas operativas a puntos de venta para los visitadores asignados</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 shadow-sm" style="min-height: 40px;" @onclick="ToggleForm">
                <i class="bi @(_showForm ? "bi-chevron-up" : "bi-calendar-plus")"></i>
                <span>@(_showForm ? "Ocultar formulario" : "Programar visita")</span>
            </button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="min-height: 40px; border-color: var(--color-border);" @onclick="LoadDataAsync" title="Actualizar datos">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Actualizar</span>
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <div>@_error</div>
    </div>
}

<!-- Panel Desplegable: Programar Visita -->
@if (_showForm)
{
    <div class="card vpdv-card border-0 shadow-sm mb-4 border-start border-4 border-primary" style="border-left: 4px solid var(--color-primary) !important;">
        <div class="card-header bg-white fw-bold py-3 d-flex align-items-center justify-content-between" style="border-bottom: 1px solid var(--color-border);">
            <div class="d-flex align-items-center gap-2 text-primary">
                <i class="bi bi-calendar-plus fs-5"></i>
                <span class="text-dark">Programar Visita a Punto de Venta</span>
            </div>
            <button type="button" class="btn-close" aria-label="Cerrar formulario" @onclick="ToggleForm"></button>
        </div>
        <div class="card-body p-4">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger py-2 small mb-3" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label" for="usuarioSelect">Visitador responsable <span class="text-danger">*</span></label>
                        <InputSelect id="usuarioSelect" class="form-select" @bind-Value="_form.UsuarioId" @bind-Value:after="CheckPdvConflict">
                            <option value="">Seleccione un visitador...</option>
                            @foreach (var usuario in UsuariosDisponibles)
                            {
                                <option value="@usuario.Id">@usuario.Nombre @usuario.Apellido (@usuario.Rol)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label" for="pdvSelect">Punto de venta <span class="text-danger">*</span></label>
                        <InputSelect id="pdvSelect" class="form-select" @bind-Value="_form.FarmaciaId" @bind-Value:after="CheckPdvConflict">
                            <option value="">Seleccione un punto de venta...</option>
                            @foreach (var farmacia in FarmaciasDisponibles)
                            {
                                <option value="@farmacia.Id">@farmacia.Codigo — @farmacia.Nombre (@farmacia.Ciudad)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="fechaPlaneada">Fecha programada <span class="text-danger">*</span></label>
                        <InputDate id="fechaPlaneada" class="form-control" @bind-Value="_form.FechaPlaneada" @bind-Value:after="CheckPdvConflict" />
                    </div>
                </div>

                <!-- Aviso informativo si el punto de venta ya tiene visita en esa fecha -->
                @if (!string.IsNullOrEmpty(_conflictNotice))
                {
                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="status">
                        <i class="bi bi-info-circle-fill flex-shrink-0 text-primary"></i>
                        <div>@_conflictNotice <span class="text-muted">(Aviso informativo: puede continuar con la asignación).</span></div>
                    </div>
                }

                <div class="mb-4">
                    <label class="form-label" for="obsInput">Instrucciones u observaciones</label>
                    <InputTextArea id="obsInput" class="form-control" rows="2" placeholder="Ej: Verificación de exhibición, revisión de inventario o informe de fachada..." @bind-Value="_form.Observaciones" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary px-3" type="button" @onclick="ToggleForm">
                        Cancelar
                    </button>
                    <button class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" type="submit" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-calendar-check"></i>
                            <span>Confirmar programación</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Sección Principal: Agenda de Visitas (100% de Ancho) -->
<div class="card vpdv-card border-0 shadow-sm">
    <div class="card-header bg-white py-3" style="border-bottom: 1px solid var(--color-border);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-task text-primary fs-5"></i>
                <span class="fw-bold text-dark fs-6">Agenda de Visitas Programadas</span>
                <span class="badge badge-soft-primary px-2 py-1 ms-1">
                    @FilteredAsignaciones.Count() visita(s)
                </span>
                @if (_desde.HasValue && _hasta.HasValue)
                {
                    <span class="text-muted small ms-2 d-none d-md-inline">
                        (Período: @_desde.Value.ToString("dd/MM/yyyy") al @_hasta.Value.ToString("dd/MM/yyyy"))
                    </span>
                }
            </div>

            <!-- Filtros: Estado y Rango de Fechas -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Filtro por Estado -->
                <select class="form-select form-select-sm" style="width: 140px; border-color: var(--color-border);" @bind="_filterEstado" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    <option value="Programada">Programada</option>
                    <option value="Completada">Completada</option>
                </select>

                <!-- Rango de Fechas -->
                <div class="d-flex align-items-center gap-1 bg-light px-2 py-1 rounded-3 border" style="border-color: var(--color-border) !important;">
                    <span class="text-muted small ps-1" title="Fecha inicio"><i class="bi bi-calendar3"></i></span>
                    <InputDate class="form-control form-control-sm border-0 bg-transparent" style="width: 130px;" @bind-Value="_desde" aria-label="Fecha desde" />
                    <span class="text-muted small">–</span>
                    <span class="text-muted small" title="Fecha fin"><i class="bi bi-calendar-check"></i></span>
                    <InputDate class="form-control form-control-sm border-0 bg-transparent" style="width: 130px;" @bind-Value="_hasta" aria-label="Fecha hasta" />
                </div>

                <button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3" style="min-height: 36px;" @onclick="LoadAsignacionesAsync" title="Aplicar filtros de fecha">
                    <i class="bi bi-funnel"></i>
                    <span>Aplicar filtros</span>
                </button>
                <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 px-2" style="min-height: 36px; border-color: var(--color-border);" @onclick="ResetFiltros" title="Restablecer fechas y filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Limpiar filtros</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Cuerpo de la Tabla / EmptyStates -->
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="d-flex flex-column justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="text-secondary small">Cargando agenda de visitas...</div>
            </div>
        }
        else if (_asignaciones is null)
        {
            <div class="p-4">
                <div class="alert alert-warning mb-0">No se pudieron cargar las visitas de la agenda.</div>
            </div>
        }
        else if (!FilteredAsignaciones.Any())
        {
            <div class="p-4">
                <EmptyState Icon="bi-calendar-x"
                            Titulo="No hay visitas que coincidan con los filtros"
                            Mensaje="No se encontraron visitas registradas para los criterios y fechas seleccionadas. Puedes ampliar el rango o programar una nueva visita."
                            BotonTexto="Limpiar filtros"
                            BotonIcono="bi-arrow-counterclockwise"
                            OnAccion="ResetFiltros" />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small">
                            <th class="ps-3" style="width: 130px;">Fecha programada</th>
                            <th style="min-width: 180px;">Visitador</th>
                            <th style="min-width: 220px;">Punto de venta (PDV)</th>
                            <th style="min-width: 200px;">Observaciones</th>
                            <th class="text-center" style="width: 130px;">Estado</th>
                            <th class="pe-3 text-end" style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asignacion in FilteredAsignaciones)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark text-nowrap">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                                    @asignacion.FechaPlaneada.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@asignacion.NombreUsuario</div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@asignacion.NombreFarmacia</div>
                                    <div class="small text-muted font-monospace">@asignacion.CodigoFarmacia</div>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(asignacion.Observaciones))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small text-truncate d-inline-block" style="max-width: 260px;" title="@asignacion.Observaciones">
                                            @asignacion.Observaciones
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(asignacion.Completada ? "badge-soft-success" : "badge-soft-primary") rounded-pill px-3 py-2">
                                        <i class="bi @(asignacion.Completada ? "bi-check-circle-fill" : "bi-clock-fill") me-1"></i>
                                        @(asignacion.Completada ? "Completada" : "Programada")
                                    </span>
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" @onclick="() => VerDetalle(asignacion)" title="Ver detalle de la visita">
                                            <i class="bi bi-eye"></i>
                                            <span class="d-none d-md-inline">Ver</span>
                                        </button>
                                        @if (!asignacion.Completada)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="visually-hidden">Acciones de visita</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="border-radius: 8px;">
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2" @onclick="() => OpenReagendarModal(asignacion)">
                                                        <i class="bi bi-calendar2-range text-warning"></i>
                                                        <span>Reagendar visita</span>
                                                    </button>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <button class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" @onclick="() => OpenDeleteConfirmModal(asignacion)">
                                                        <i class="bi bi-trash"></i>
                                                        <span>Eliminar asignación</span>
                                                    </button>
                                                </li>
                                            </ul>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Ver Detalle de Visita -->
@if (_selectedDetalle != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center badge-soft-primary text-primary">
                            <i class="bi bi-calendar-event fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">Detalle de Visita</h5>
                            <span class="text-secondary small font-monospace">ID: @_selectedDetalle.Id</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _selectedDetalle = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label text-muted small mb-0">Fecha programada</label>
                            <div class="fw-bold text-dark">@_selectedDetalle.FechaPlaneada.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small mb-0">Estado operativo</label>
                            <div>
                                <span class="badge @(_selectedDetalle.Completada ? "badge-soft-success" : "badge-soft-primary") rounded-pill px-3 py-1">
                                    @(_selectedDetalle.Completada ? "Completada" : "Programada")
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small mb-0">Visitador responsable</label>
                            <div class="fw-semibold text-dark">@_selectedDetalle.NombreUsuario</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-muted small mb-0">Punto de venta</label>
                            <div class="fw-semibold text-dark">@_selectedDetalle.NombreFarmacia</div>
                            <div class="text-muted small font-monospace">@_selectedDetalle.CodigoFarmacia</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small mb-0">Observaciones e instrucciones</label>
                            <div class="p-2 bg-light rounded-2 border text-secondary small">
                                @(string.IsNullOrWhiteSpace(_selectedDetalle.Observaciones) ? "Sin observaciones registradas." : _selectedDetalle.Observaciones)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _selectedDetalle = null">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Reagendar Visita -->
@if (_reagendarModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center badge-soft-warning text-warning">
                            <i class="bi bi-calendar2-range fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">Reagendar Visita</h5>
                            <span class="text-secondary small">@_reagendarModel.NombreFarmacia — @_reagendarModel.NombreUsuario</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _reagendarModel = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label">Nueva fecha programada <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="_nuevaFechaReagendada" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo o justificativo del reagendamiento <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" placeholder="Indique la justificación operativa del cambio de fecha..." @bind="_justificativoReagendamiento"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _reagendarModel = null">Cancelar</button>
                    <button type="button" class="btn btn-primary px-3" disabled="@_saving" @onclick="ConfirmarReagendarAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Confirmar nueva fecha
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Confirmación de Eliminación -->
@if (_deletingModel != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>Confirmar Eliminación de Asignación</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="() => _deletingModel = null"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-2">¿Está seguro de que desea eliminar la asignación para el punto de venta <strong>@_deletingModel.NombreFarmacia (@_deletingModel.CodigoFarmacia)</strong> programada para el <strong>@_deletingModel.FechaPlaneada.ToString("dd/MM/yyyy")</strong>?</p>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i> Esta acción eliminará permanentemente la asignación de la agenda. El backend actualmente implementa borrado de registro.
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _deletingModel = null">Cancelar</button>
                    <button type="button" class="btn btn-danger px-3" disabled="@_saving" @onclick="ConfirmarEliminarAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Eliminar permanentemente
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show align-items-center text-white bg-success border-0 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@_message</span>
                </div>
                <button class="btn-close btn-close-white me-2 m-auto" @onclick="() => _message = null"></button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] ApiClient Api { get; set; } = default!;

    private IEnumerable<AsignacionFarmaciaModel>? _asignaciones;
    private IEnumerable<UsuarioModel> _usuarios = [];
    private IEnumerable<FarmaciaModel> _farmacias = [];
    private AsignacionForm _form = new();
    private DateTime? _desde = DateTime.Today;
    private DateTime? _hasta = DateTime.Today.AddDays(7);
    private string _filterEstado = string.Empty;
    private string? _conflictNotice;

    private bool _loading;
    private bool _saving;
    private bool _showForm = false;
    private string? _error;
    private string? _message;

    // Modales
    private AsignacionFarmaciaModel? _selectedDetalle;
    private AsignacionFarmaciaModel? _reagendarModel;
    private DateTime _nuevaFechaReagendada = DateTime.Today.AddDays(1);
    private string _justificativoReagendamiento = string.Empty;
    private AsignacionFarmaciaModel? _deletingModel;

    private IEnumerable<UsuarioModel> UsuariosDisponibles => _usuarios
        .Where(u => u.Activo)
        .OrderBy(u => u.Apellido)
        .ThenBy(u => u.Nombre);

    private IEnumerable<FarmaciaModel> FarmaciasDisponibles => _farmacias
        .Where(f => f.Activo)
        .OrderBy(f => f.Nombre);

    private IEnumerable<AsignacionFarmaciaModel> FilteredAsignaciones
    {
        get
        {
            var items = _asignaciones ?? Enumerable.Empty<AsignacionFarmaciaModel>();
            if (!string.IsNullOrEmpty(_filterEstado))
            {
                if (_filterEstado == "Completada")
                    items = items.Where(a => a.Completada);
                else if (_filterEstado == "Programada")
                    items = items.Where(a => !a.Completada);
            }
            return items.OrderBy(a => a.FechaPlaneada);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private void ToggleForm() => _showForm = !_showForm;

    private void CheckPdvConflict()
    {
        _conflictNotice = null;
        if (!string.IsNullOrEmpty(_form.FarmaciaId) && _asignaciones != null)
        {
            var conflict = _asignaciones.FirstOrDefault(a => 
                a.FarmaciaId == _form.FarmaciaId && 
                a.FechaPlaneada.Date == _form.FechaPlaneada.Date &&
                !a.Completada);

            if (conflict != null)
            {
                _conflictNotice = $"El punto de venta '{conflict.NombreFarmacia}' ya tiene una visita programada para esta fecha con {conflict.NombreUsuario}.";
            }
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;

        var usuariosResult = await Api.GetUsuariosResultAsync();
        var farmaciasResult = await Api.GetFarmaciasResultAsync();
        var asignacionesResult = await Api.GetAsignacionesResultAsync(_desde, _hasta);

        _usuarios = usuariosResult.Data?.ToArray() ?? [];
        _farmacias = farmaciasResult.Data?.ToArray() ?? [];
        _asignaciones = asignacionesResult.Data?.ToArray();
        _error = usuariosResult.ErrorMessage ?? farmaciasResult.ErrorMessage ?? asignacionesResult.ErrorMessage;

        _loading = false;
    }

    private async Task LoadAsignacionesAsync()
    {
        _loading = true;
        var result = await Api.GetAsignacionesResultAsync(_desde, _hasta);
        _asignaciones = result.Data?.ToArray();
        _error = result.ErrorMessage;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        var result = await Api.CreateAsignacionAsync(new CreateAsignacionModel(
            _form.FarmaciaId,
            _form.UsuarioId,
            _form.FechaPlaneada,
            _form.Observaciones));

        _error = result.ErrorMessage;
        if (result.Success)
        {
            _message = "Visita agendada con éxito.";
            _form = new AsignacionForm();
            _conflictNotice = null;
            _showForm = false;
            await LoadAsignacionesAsync();
        }

        _saving = false;
    }

    private void VerDetalle(AsignacionFarmaciaModel asignacion)
    {
        _selectedDetalle = asignacion;
    }

    private void OpenReagendarModal(AsignacionFarmaciaModel asignacion)
    {
        _reagendarModel = asignacion;
        _nuevaFechaReagendada = asignacion.FechaPlaneada.AddDays(1);
        _justificativoReagendamiento = string.Empty;
    }

    private async Task ConfirmarReagendarAsync()
    {
        if (_reagendarModel == null) return;
        if (string.IsNullOrWhiteSpace(_justificativoReagendamiento))
        {
            _error = "Debe indicar el justificativo u observación del reagendamiento.";
            return;
        }

        _saving = true;
        _error = null;

        // Se elimina la asignación previa y se crea la reagendada con el justificativo en observaciones
        var delResult = await Api.DeleteAsignacionAsync(_reagendarModel.Id);
        if (delResult.Success)
        {
            var obs = string.IsNullOrWhiteSpace(_reagendarModel.Observaciones)
                ? $"Reagendada: {_justificativoReagendamiento.Trim()}"
                : $"{_reagendarModel.Observaciones} | Reagendada: {_justificativoReagendamiento.Trim()}";

            var createResult = await Api.CreateAsignacionAsync(new CreateAsignacionModel(
                _reagendarModel.FarmaciaId,
                _reagendarModel.UsuarioId,
                _nuevaFechaReagendada,
                obs));

            if (createResult.Success)
            {
                _message = "Visita reagendada exitosamente.";
                _reagendarModel = null;
                await LoadAsignacionesAsync();
            }
            else
            {
                _error = createResult.ErrorMessage;
            }
        }
        else
        {
            _error = delResult.ErrorMessage;
        }

        _saving = false;
    }

    private void OpenDeleteConfirmModal(AsignacionFarmaciaModel asignacion)
    {
        _deletingModel = asignacion;
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (_deletingModel == null) return;
        _saving = true;
        _error = null;

        var result = await Api.DeleteAsignacionAsync(_deletingModel.Id);
        _error = result.ErrorMessage;
        if (result.Success)
        {
            _message = "Asignación eliminada de la agenda.";
            _deletingModel = null;
            await LoadAsignacionesAsync();
        }

        _saving = false;
    }

    private async Task ResetFiltros()
    {
        _filterEstado = string.Empty;
        _desde = DateTime.Today;
        _hasta = DateTime.Today.AddDays(7);
        await LoadAsignacionesAsync();
    }

    private sealed class AsignacionForm
    {
        [Required(ErrorMessage = "Seleccione un visitador.")]
        public string UsuarioId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione un punto de venta.")]
        public string FarmaciaId { get; set; } = string.Empty;

        [Required]
        public DateTime FechaPlaneada { get; set; } = DateTime.Today;

        [StringLength(500)]
        public string? Observaciones { get; set; }
    }
}
