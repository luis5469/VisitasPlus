@page "/farmacias"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@implements IDisposable

<PageTitle>Puntos de Venta — VisitaPDV Admin</PageTitle>

<!-- Header Principal -->
<div class="card vpdv-card border-0 shadow-sm p-3 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-shop text-primary"></i>
                <span>Administración de Puntos de Venta</span>
            </h4>
            <p class="text-secondary small mb-0">Catálogo general de puntos de venta (PDV), geocercas y asignación de responsables</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 shadow-sm" style="min-height: 40px;" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle"></i>
                <span>Nuevo punto de venta</span>
            </button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" style="min-height: 40px; border-color: var(--color-border);" @onclick="LoadFarmaciasAsync" title="Actualizar lista">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Actualizar</span>
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
        <div>@_error</div>
    </div>
}

<!-- Tabla de Puntos de Venta (100% de Ancho) -->
<div class="card vpdv-card border-0 shadow-sm">
    <!-- Barra Coherente de Filtros y Búsqueda Superior -->
    <div class="card-header bg-white py-3" style="border-bottom: 1px solid var(--color-border);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-columns-reverse text-primary fs-5"></i>
                <span class="fw-bold text-dark fs-6">Puntos de Venta Registrados</span>
                <span class="badge badge-soft-primary px-2 py-1 ms-1">
                    @FilteredFarmacias.Count() punto(s) de venta
                </span>
            </div>

            <!-- Búsqueda y Filtros por Ciudad y Estado -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: var(--color-border);">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" 
                           style="border-color: var(--color-border);"
                           placeholder="Buscar por código, nombre o dirección..." 
                           @bind="_searchTerm" @bind:event="oninput"
                           aria-label="Buscar punto de venta" />
                    @if (!string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <button class="btn btn-outline-secondary border-start-0" style="border-color: var(--color-border);" type="button" @onclick="() => _searchTerm = string.Empty" title="Limpiar texto">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>

                <!-- Filtro por Ciudad -->
                <select class="form-select form-select-sm" style="width: 140px; border-color: var(--color-border);" @bind="_filterCiudad" aria-label="Filtrar por ciudad">
                    <option value="">Todas las ciudades</option>
                    @foreach (var c in CiudadesDisponibles)
                    {
                        <option value="@c">@c</option>
                    }
                </select>

                <!-- Filtro por Estado -->
                <select class="form-select form-select-sm" style="width: 130px; border-color: var(--color-border);" @bind="_filterEstado" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>
                    <option value="activo">Activo</option>
                    <option value="inactivo">Inactivo</option>
                </select>

                @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_filterCiudad) || !string.IsNullOrWhiteSpace(_filterEstado))
                {
                    <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" style="min-height: 36px;" @onclick="LimpiarFiltros" title="Limpiar búsqueda y filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Limpiar filtros</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Cuerpo de la Tabla -->
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="d-flex flex-column justify-content-center align-items-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="text-secondary small">Cargando catálogo de puntos de venta...</div>
            </div>
        }
        else if (_farmacias is null)
        {
            <div class="p-4">
                <div class="alert alert-warning mb-0">No se pudieron cargar los puntos de venta.</div>
            </div>
        }
        else if (!FilteredFarmacias.Any())
        {
            <div class="p-4">
                <EmptyState Icon="bi-shop"
                            Titulo="No se encontraron puntos de venta"
                            Mensaje="@(string.IsNullOrWhiteSpace(_searchTerm) && string.IsNullOrWhiteSpace(_filterCiudad) && string.IsNullOrWhiteSpace(_filterEstado) ? "Aún no se han configurado puntos de venta en el sistema." : "No hay resultados que coincidan con los criterios de búsqueda.")"
                            BotonTexto="Limpiar filtros"
                            BotonIcono="bi-arrow-counterclockwise"
                            OnAccion="LimpiarFiltros" />
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small">
                            <th class="ps-3" style="width: 130px;">Código</th>
                            <th style="min-width: 220px;">Punto de venta</th>
                            <th style="min-width: 240px;">Dirección</th>
                            <th style="width: 160px;">Ciudad y Zona</th>
                            <th style="width: 180px;">Responsable</th>
                            <th class="text-center" style="width: 120px;">Estado</th>
                            <th class="pe-3 text-end" style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var farmacia in FilteredFarmacias)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary font-monospace">@farmacia.Codigo</td>
                                <td>
                                    <div class="fw-semibold text-dark">@farmacia.Nombre</div>
                                </td>
                                <td>
                                    <div class="small text-secondary">
                                        <i class="bi bi-geo-alt me-1 text-muted"></i>@farmacia.Direccion
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@farmacia.Ciudad</div>
                                    <div class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(farmacia.Zona) ? "Sin zona asignada" : farmacia.Zona)
                                    </div>
                                </td>
                                <td>
                                    <div class="text-secondary small fw-medium">@(string.IsNullOrWhiteSpace(farmacia.Responsable) ? "—" : farmacia.Responsable)</div>
                                    @if (!string.IsNullOrWhiteSpace(farmacia.Telefono))
                                    {
                                        <div class="text-muted small font-monospace"><i class="bi bi-telephone me-1"></i>@farmacia.Telefono</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(farmacia.Activo ? "badge-soft-success" : "badge-soft-danger") rounded-pill px-3 py-2">
                                        <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i>
                                        @(farmacia.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" title="Editar punto de venta" @onclick="() => EditFarmacia(farmacia)">
                                            <i class="bi bi-pencil"></i>
                                            <span>Editar</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-@(farmacia.Activo ? "danger" : "success") d-inline-flex align-items-center gap-1"
                                                title="@(farmacia.Activo ? "Desactivar punto de venta" : "Reactivar punto de venta")"
                                                @onclick="() => OpenToggleConfirmModal(farmacia)">
                                            <i class="bi bi-@(farmacia.Activo ? "slash-circle" : "check-circle")"></i>
                                            <span>@(farmacia.Activo ? "Desactivar" : "Reactivar")</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Confirmación de Desactivación / Reactivación de Punto de Venta -->
@if (_toggleConfirmFarmacia != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(15, 23, 42, 0.6); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px;">
                <div class="modal-header @(_toggleConfirmFarmacia.Activo ? "bg-danger text-white" : "bg-success text-white") py-3">
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="bi @(_toggleConfirmFarmacia.Activo ? "bi-slash-circle" : "bi-check-circle")"></i>
                        <span>@(_toggleConfirmFarmacia.Activo ? "Desactivar punto de venta" : "Reactivar punto de venta")</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Cerrar" @onclick="() => _toggleConfirmFarmacia = null"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-3">
                        ¿Está seguro de que desea @(_toggleConfirmFarmacia.Activo ? "desactivar" : "reactivar") el siguiente punto de venta?
                    </p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark fs-6">@_toggleConfirmFarmacia.Nombre</div>
                        <div class="text-secondary small font-monospace">Código: @_toggleConfirmFarmacia.Codigo</div>
                        <div class="text-secondary small">Ciudad: @_toggleConfirmFarmacia.Ciudad - @(string.IsNullOrWhiteSpace(_toggleConfirmFarmacia.Zona) ? "Sin zona" : _toggleConfirmFarmacia.Zona)</div>
                        <div class="text-secondary small">Dirección: @_toggleConfirmFarmacia.Direccion</div>
                    </div>
                    @if (_toggleConfirmFarmacia.Activo)
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Efecto operativo:</strong> Al desactivar este punto de venta, dejará de aparecer en la lista de opciones para programar nuevas visitas. Las visitas ya ejecutadas o registradas conservarán su trazabilidad histórica.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Efecto operativo:</strong> El punto de venta volverá a estar disponible de inmediato para planificar visitas en la agenda.
                        </div>
                    }
                </div>
                <div class="modal-footer border-top py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _toggleConfirmFarmacia = null">Cancelar</button>
                    <button type="button" class="btn @(_toggleConfirmFarmacia.Activo ? "btn-danger" : "btn-success") px-3" disabled="@_saving" @onclick="ConfirmarToggleActivoAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>@(_toggleConfirmFarmacia.Activo ? "Confirmar desactivación" : "Confirmar reactivación")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Formulario de Creación / Edición -->
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.6); z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                <div class="modal-header bg-white py-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center @(!string.IsNullOrEmpty(_editingId) ? "badge-soft-warning text-warning" : "badge-soft-primary text-primary")">
                            <i class="bi @(!string.IsNullOrEmpty(_editingId) ? "bi-pencil-square" : "bi-plus-circle") fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0">
                                @(!string.IsNullOrEmpty(_editingId) ? "Editar Punto de Venta" : "Registrar Nuevo Punto de Venta")
                            </h5>
                            <span class="text-secondary small">Complete los datos y calibre la ubicación geográfica con su geocerca</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar modal" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body p-4">
                    <EditForm Model="_form" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger py-2 small mb-3" />

                        <!-- Fila 1: Código + Nombre -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label" for="codPdv">Código <span class="text-danger">*</span></label>
                                <InputText id="codPdv" class="form-control" @bind-Value="_form.Codigo" placeholder="Ej: FAR-001" />
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label" for="nomPdv">Nombre del punto de venta <span class="text-danger">*</span></label>
                                <InputText id="nomPdv" class="form-control" @bind-Value="_form.Nombre" placeholder="Ej: Farmacia Central Matriz" />
                            </div>
                        </div>

                        <!-- Fila 2: Dirección Completa -->
                        <div class="mb-3">
                            <label class="form-label" for="dirPdv">Dirección completa <span class="text-danger">*</span></label>
                            <InputText id="dirPdv" class="form-control" @bind-Value="_form.Direccion" placeholder="Ej: Av. Amazonas y República" />
                        </div>

                        <!-- Fila 3: Ciudad + Zona -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="ciuPdv">Ciudad <span class="text-danger">*</span></label>
                                <InputText id="ciuPdv" class="form-control" @bind-Value="_form.Ciudad" placeholder="Ej: Quito" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="zonPdv">Zona o sector</label>
                                <InputText id="zonPdv" class="form-control" @bind-Value="_form.Zona" placeholder="Ej: Norte / La Carolina" />
                            </div>
                        </div>

                        <!-- Fila 4: Responsable + Teléfono -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="respPdv">Responsable en farmacia</label>
                                <InputText id="respPdv" class="form-control" @bind-Value="_form.Responsable" placeholder="Ej: Juan Pérez" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="telPdv">Teléfono de contacto</label>
                                <InputText id="telPdv" class="form-control" @bind-Value="_form.Telefono" placeholder="Ej: 0991234567" />
                            </div>
                        </div>

                        <!-- Fila 5: Coordenadas y Geocerca -->
                        <div class="row g-2 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label" for="latPdv">Latitud</label>
                                <InputNumber id="latPdv" class="form-control form-control-sm" @bind-Value="_form.Latitud" @bind-Value:after="OnManualCoordsOrGeofenceChanged" step="0.000001" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label" for="lngPdv">Longitud</label>
                                <InputNumber id="lngPdv" class="form-control form-control-sm" @bind-Value="_form.Longitud" @bind-Value:after="OnManualCoordsOrGeofenceChanged" step="0.000001" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label" for="geoPdv">Geocerca (metros)</label>
                                <InputNumber id="geoPdv" class="form-control form-control-sm" @bind-Value="_form.GeofenceMetros" @bind-Value:after="OnManualCoordsOrGeofenceChanged" />
                            </div>
                        </div>

                        <!-- Estado de Geocerca -->
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <span class="text-secondary small fw-semibold">Estado de geocerca:</span>
                            @if (_form.GeofenceMetros > 0 && Math.Abs(_form.Latitud) > 0.000001m && Math.Abs(_form.Longitud) > 0.000001m)
                            {
                                <span class="badge badge-soft-success rounded-pill px-2.5 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Configurada (@_form.GeofenceMetros m)
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-soft-warning rounded-pill px-2.5 py-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Sin configurar o coordenadas en cero
                                </span>
                            }
                        </div>

                        <!-- Selector de Mapa y Geolocalización Asistida -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0">Ubicación y Geocerca en Mapa</label>
                                <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" style="min-height: 28px; padding: 0.15rem 0.5rem; font-size: 0.78rem;" @onclick="GetMyLocationAsync">
                                    <i class="bi bi-crosshair"></i>
                                    <span>Mi ubicación actual</span>
                                </button>
                            </div>
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" @bind="_searchAddress" class="form-control" placeholder="Buscar dirección (ej: Av. Shyris, Quito)..." onkeydown="if (event.key === 'Enter') { event.preventDefault(); }" @onkeyup="HandleSearchKeyUp" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="SearchAddressAsync">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div id="farmacia-map" style="height: 240px; border-radius: 8px; border: 1px solid var(--color-border); z-index: 1;"></div>
                            <span class="text-muted d-block mt-1" style="font-size: 0.75rem;">Haz clic en el mapa o arrastra el marcador para calibrar la ubicación exacta del punto de venta.</span>
                        </div>

                        <!-- Acciones del Modal -->
                        <div class="modal-footer px-0 pb-0 pt-3 border-top d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary px-3" @onclick="CloseModal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-lg"></i>
                                    <span>@(!string.IsNullOrEmpty(_editingId) ? "Guardar cambios" : "Crear punto de venta")</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show align-items-center text-white bg-success border-0 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <span>@_message</span>
                </div>
                <button class="btn-close btn-close-white me-2 m-auto" @onclick="() => _message = null"></button>
            </div>
        </div>
    </div>
}

@code {
    [Inject] ApiClient Api { get; set; } = default!;
    [Inject] IJSRuntime Js { get; set; } = default!;

    private string _searchTerm = string.Empty;
    private string _filterCiudad = string.Empty;
    private string _filterEstado = string.Empty;
    private string _searchAddress = string.Empty;
    private DotNetObjectReference<Farmacias>? _selfReference;

    private IEnumerable<FarmaciaModel>? _farmacias;
    private FarmaciaForm _form = new();
    private string? _editingId;
    private bool _loading;
    private bool _saving;
    private bool _showModal = false;
    private FarmaciaModel? _toggleConfirmFarmacia;
    private string? _error;
    private string? _message;

    private IEnumerable<string> CiudadesDisponibles =>
        (_farmacias ?? Enumerable.Empty<FarmaciaModel>())
            .Select(f => f.Ciudad)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c);

    private IEnumerable<FarmaciaModel> FilteredFarmacias =>
        (_farmacias ?? Enumerable.Empty<FarmaciaModel>()).Where(f =>
            (string.IsNullOrWhiteSpace(_searchTerm) ||
             f.Codigo.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             f.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             f.Direccion.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_filterCiudad) || string.Equals(f.Ciudad, _filterCiudad, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_filterEstado) || 
             (_filterEstado == "activo" && f.Activo) || 
             (_filterEstado == "inactivo" && !f.Activo)));

    protected override async Task OnInitializedAsync()
    {
        await LoadFarmaciasAsync();
    }

    private async Task LoadFarmaciasAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetFarmaciasResultAsync();
        _farmacias = result.Data?.OrderBy(f => f.Nombre).ToArray();
        _error = result.ErrorMessage;
        _loading = false;
    }

    private void LimpiarFiltros()
    {
        _searchTerm = string.Empty;
        _filterCiudad = string.Empty;
        _filterEstado = string.Empty;
    }

    private void OpenToggleConfirmModal(FarmaciaModel farmacia)
    {
        _toggleConfirmFarmacia = farmacia;
    }

    private async Task ConfirmarToggleActivoAsync()
    {
        if (_toggleConfirmFarmacia == null) return;
        _saving = true;
        var result = await Api.ToggleFarmaciaActivoAsync(_toggleConfirmFarmacia.Id, !_toggleConfirmFarmacia.Activo);
        _saving = false;
        if (result.Success)
        {
            _message = $"Punto de venta '{_toggleConfirmFarmacia.Nombre}' {(!_toggleConfirmFarmacia.Activo ? "reactivado" : "desactivado")} exitosamente.";
            _toggleConfirmFarmacia = null;
            await LoadFarmaciasAsync();
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }

    private async Task OpenCreateModal()
    {
        _editingId = null;
        _form = new FarmaciaForm();
        _showModal = true;
        await Task.Delay(150);
        await InitializeOrUpdateMap();
    }

    private async Task CloseModal()
    {
        _showModal = false;
        _editingId = null;
        _form = new FarmaciaForm();
    }

    private async Task EditFarmacia(FarmaciaModel farmacia)
    {
        _editingId = farmacia.Id;
        _form = new FarmaciaForm
        {
            Codigo = farmacia.Codigo,
            Nombre = farmacia.Nombre,
            Direccion = farmacia.Direccion,
            Ciudad = farmacia.Ciudad,
            Zona = farmacia.Zona,
            Responsable = farmacia.Responsable,
            Telefono = farmacia.Telefono,
            Latitud = farmacia.Latitud,
            Longitud = farmacia.Longitud,
            GeofenceMetros = farmacia.GeofenceMetros,
        };
        _showModal = true;
        await Task.Delay(150);
        await InitializeOrUpdateMap();
    }

    private async Task InitializeOrUpdateMap()
    {
        _selfReference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("farmaciaMap.init", _selfReference, _form.Latitud, _form.Longitud, _form.GeofenceMetros);
        await Js.InvokeVoidAsync("farmaciaMap.invalidateSize");
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        var payload = new UpsertFarmaciaModel(
            _form.Codigo,
            _form.Nombre,
            _form.Direccion,
            _form.Ciudad,
            _form.Zona,
            _form.Responsable,
            _form.Telefono,
            _form.Latitud,
            _form.Longitud,
            _form.GeofenceMetros);

        if (!string.IsNullOrEmpty(_editingId))
        {
            var result = await Api.UpdateFarmaciaAsync(_editingId, payload);
            _error = result.ErrorMessage;
            if (result.Success)
            {
                _message = "Punto de venta actualizado con éxito.";
                _showModal = false;
                await LoadFarmaciasAsync();
            }
        }
        else
        {
            var result = await Api.CreateFarmaciaAsync(payload);
            _error = result.ErrorMessage;
            if (result.Success)
            {
                _message = "Punto de venta creado con éxito.";
                _showModal = false;
                await LoadFarmaciasAsync();
            }
        }

        _saving = false;
    }

    private async Task UpdateMapAsync()
    {
        await Js.InvokeVoidAsync("farmaciaMap.update", _form.Latitud, _form.Longitud, _form.GeofenceMetros);
    }

    private async Task OnManualCoordsOrGeofenceChanged()
    {
        await UpdateMapAsync();
    }

    private async Task SearchAddressAsync()
    {
        if (!string.IsNullOrWhiteSpace(_searchAddress))
        {
            await Js.InvokeVoidAsync("farmaciaMap.searchAddress", _searchAddress);
        }
    }

    private async Task GetMyLocationAsync()
    {
        await Js.InvokeVoidAsync("farmaciaMap.getCurrentLocation");
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAddressAsync();
        }
    }

    [JSInvokable]
    public void UpdateCoordinates(decimal lat, decimal lng)
    {
        _form.Latitud = Math.Round(lat, 6);
        _form.Longitud = Math.Round(lng, 6);
        StateHasChanged();
    }

    public void Dispose()
    {
        _selfReference?.Dispose();
    }

    private sealed class FarmaciaForm
    {
        [Required(ErrorMessage = "El código es obligatorio.")]
        [StringLength(20)]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(200)]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(300)]
        public string Direccion { get; set; } = string.Empty;

        [Required(ErrorMessage = "La ciudad es obligatoria.")]
        [StringLength(100)]
        public string Ciudad { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Zona { get; set; }

        [StringLength(150)]
        public string? Responsable { get; set; }

        [StringLength(20)]
        public string? Telefono { get; set; }

        [Range(typeof(decimal), "-90", "90")]
        public decimal Latitud { get; set; }

        [Range(typeof(decimal), "-180", "180")]
        public decimal Longitud { get; set; }

        [Range(10, 5000)]
        public int GeofenceMetros { get; set; } = 100;
    }
}
