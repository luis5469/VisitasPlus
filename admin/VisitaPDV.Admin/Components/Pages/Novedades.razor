@page "/novedades"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using VisitaPDV.Admin.Models

<PageTitle>Seguimiento de Novedades — VisitaPDV Admin</PageTitle>

<div class="container-fluid py-2">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-chat-left-text-fill text-primary me-2"></i>Seguimiento de Novedades</h4>
            <p class="text-muted small mb-0">Gestiona y resuelve las incidencias reportadas por los visitadores en el punto de venta.</p>
        </div>
        <button class="btn btn-outline-primary btn-sm" @onclick="LoadDataAsync">
            <i class="bi bi-arrow-clockwise me-1"></i> Refrescar
        </button>
    </div>

    <!-- KPIs y Badges Superiores con KpiCard Estandarizado -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <KpiCard Titulo="Novedades Abiertas"
                     Valor="@_cntAbiertas.ToString()"
                     Subtitulo="Total registradas"
                     Icono="bi-folder2-open"
                     Color="primary" />
        </div>
        <div class="col-sm-6 col-md-3">
            <KpiCard Titulo="En Proceso"
                     Valor="@_cntEnProgreso.ToString()"
                     Subtitulo="En atención operativa"
                     Icono="bi-gear"
                     Color="warning" />
        </div>
        <div class="col-sm-6 col-md-3">
            <KpiCard Titulo="Pendiente de información"
                     Valor="@_cntPendientesInfo.ToString()"
                     Subtitulo="Requiere datos del visitador"
                     Icono="bi-info-circle"
                     Color="danger"
                     Alerta="@(_cntPendientesInfo > 0)" />
        </div>
        <div class="col-sm-6 col-md-3">
            <KpiCard Titulo="Vencidas"
                     Valor="@_cntVencidas.ToString()"
                     Subtitulo="Alerta por plazo excedido"
                     Icono="bi-alarm"
                     Color="danger"
                     Alerta="@(_cntVencidas > 0)" />
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Estado</label>
                    <select class="form-select form-select-sm" @bind="_filterEstado">
                        <option value="">Todos</option>
                        <option value="Abierta">Abierta</option>
                        <option value="EnProgreso">En Proceso</option>
                        <option value="Resuelta">Resuelta</option>
                        <option value="Cerrada">Cerrada</option>
                        <option value="Reabierta">Reabierta</option>
                        <option value="Vencida">Vencida</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="PendienteInformacion">Pendiente Info</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Categoría</label>
                    <select class="form-select form-select-sm" @bind="_filterCategoria">
                        <option value="">Todas</option>
                        @foreach (var cat in _categorias)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Prioridad</label>
                    <select class="form-select form-select-sm" @bind="_filterPrioridad">
                        <option value="">Todas</option>
                        @foreach (var prio in _prioridades)
                        {
                            <option value="@prio">@prio</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Punto de venta (PDV)</label>
                    <select class="form-select form-select-sm" @bind="_filterPdvId">
                        <option value="">Todos los puntos de venta</option>
                        @if (_farmacias != null)
                        {
                            @foreach (var f in _farmacias)
                            {
                                <option value="@f.Id">@f.Nombre (@f.Codigo)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Responsable</label>
                    <select class="form-select form-select-sm" @bind="_filterResponsableId">
                        <option value="">Todos los responsables</option>
                        @if (_usuarios != null)
                        {
                            @foreach (var u in _usuarios)
                            {
                                <option value="@u.Id">@u.Nombre @u.Apellido (@u.Rol)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filterDesde" aria-label="Fecha desde" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label small fw-semibold text-muted">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filterHasta" aria-label="Fecha hasta" />
                </div>
                <div class="col-md-6 d-flex align-items-end justify-content-end gap-2">
                    <button class="btn btn-sm btn-outline-secondary px-3" @onclick="ClearFiltersAsync" title="Restablecer todos los filtros">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar filtros
                    </button>
                    <button class="btn btn-sm btn-primary px-4" @onclick="LoadNovedadesAsync" title="Aplicar los filtros seleccionados">
                        <i class="bi bi-funnel me-1"></i> Aplicar filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error / Alerta -->
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
            <div>@_error</div>
        </div>
    }

    <!-- Contenido Principal: Tabla a la Izquierda, Detalle a la Derecha -->
    <div class="row g-4">
        <!-- Tabla de Novedades -->
        <div class="@(_selectedNovedad != null ? "col-lg-7" : "col-lg-12") transition-all">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">Listado de Novedades</h6>
                    <span class="badge bg-light text-dark fw-normal">Total: @(_pagedResponse?.TotalItems ?? 0)</span>
                </div>
                <div class="card-body p-0">
                    @if (_loadingList)
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center py-5">
                            <div class="spinner-border text-primary mb-2" role="status">
                                <span class="visually-hidden">Consultando novedades...</span>
                            </div>
                            <div class="text-secondary small">Consultando listado de novedades...</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_listError))
                    {
                        <div class="p-4 text-center">
                            <div class="text-danger mb-2"><i class="bi bi-exclamation-triangle-fill fs-2"></i></div>
                            <h6 class="fw-bold text-dark">Error al consultar las novedades</h6>
                            <p class="text-secondary small mb-3">@_listError</p>
                            <button class="btn btn-sm btn-primary px-3" @onclick="LoadNovedadesAsync">
                                <i class="bi bi-arrow-clockwise me-1"></i> Reintentar
                            </button>
                        </div>
                    }
                    else if (_pagedResponse == null || !_pagedResponse.Items.Any())
                    {
                        <div class="p-4">
                            @if (HasActiveFilters)
                            {
                                <EmptyState Icon="bi-funnel"
                                            Titulo="No hay novedades que coincidan con los filtros"
                                            Mensaje="No se encontraron registros para los criterios de estado, categoría o fechas aplicados."
                                            BotonTexto="Limpiar filtros"
                                            BotonIcono="bi-arrow-counterclockwise"
                                            OnAccion="ClearFiltersAsync" />
                            }
                            else
                            {
                                <EmptyState Icon="bi-chat-left-dots"
                                            Titulo="Aún no se han registrado novedades"
                                            Mensaje="No existen incidencias reportadas en el sistema para los puntos de venta." />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm align-middle mb-0">
                                <thead class="table-light text-muted uppercase font-monospace small">
                                    <tr>
                                        <th class="ps-3 py-2">Fecha</th>
                                        <th>Título</th>
                                        <th>Punto de Venta</th>
                                        <th>Categoría</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Límite</th>
                                        <th class="pe-3"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _pagedResponse.Items)
                                    {
                                        var esVencida = item.FechaSeguimiento < DateTime.Today && item.Estado != "Resuelta" && item.Estado != "Cerrada" && item.Estado != "Cancelada";
                                        <tr class="@(esVencida ? "table-danger table-danger-highlight" : "") @(_selectedNovedad?.Id == item.Id ? "table-active fw-semibold border-start border-4 border-primary" : "") cursor-pointer"
                                            @onclick="() => SelectNovedadAsync(item.Id)">
                                            <td class="ps-3 text-muted small">@item.CreadoEn.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <div class="text-dark text-truncate" style="max-width: 180px;">@item.Titulo</div>
                                                @if (esVencida)
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill small-badge">
                                                        <i class="bi bi-alarm-fill me-1 animate-pulse"></i>Vencida
                                                    </span>
                                                }
                                            </td>
                                            <td class="small">
                                                <div class="fw-semibold">@GetPdvNombre(item.PdvId)</div>
                                                <div class="text-muted small">@item.PdvId</div>
                                            </td>
                                            <td class="small">@item.Categoria</td>
                                            <td>
                                                <span class="badge bg-@GetPrioridadColor(item.Prioridad) bg-opacity-10 text-@GetPrioridadColor(item.Prioridad) rounded-pill">
                                                    @item.Prioridad
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@GetEstadoColor(item.Estado) rounded-pill text-white shadow-sm">
                                                    @GetEstadoLabel(item.Estado)
                                                </span>
                                            </td>
                                            <td class="small text-muted">@item.FechaSeguimiento.ToString("dd/MM/yyyy")</td>
                                            <td class="pe-3 text-end">
                                                @if (item.TotalImagenes > 0)
                                                {
                                                    <span class="badge bg-light text-muted rounded-pill" title="@item.TotalImagenes imágenes adjuntas">
                                                        <i class="bi bi-image me-1"></i>@item.TotalImagenes
                                                    </span>
                                                }
                                                <i class="bi bi-chevron-right text-muted small ms-1"></i>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <!-- Paginación -->
                @if (_pagedResponse != null && _pagedResponse.TotalPaginas > 1)
                {
                    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Página @_page de @_pagedResponse.TotalPaginas — @_pagedResponse.TotalItems total</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-xs btn-outline-secondary px-2" disabled="@(_page <= 1)" @onclick="PrevPageAsync">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </button>
                            <button class="btn btn-xs btn-outline-secondary px-2" disabled="@(_page >= _pagedResponse.TotalPaginas)" @onclick="NextPageAsync">
                                Siguiente <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Panel de Detalle -->
        @if (_selectedNovedad != null)
        {
            <div class="col-lg-5 transition-all">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-eye-fill text-primary me-2"></i>Detalle de Novedad</h6>
                        <button class="btn-close" @onclick="CloseDetalle"></button>
                    </div>

                    @if (_loadingDetail)
                    {
                        <div class="card-body py-5 text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card-body pt-0 overflow-auto" style="max-height: 75vh;">
                            <!-- Banner de Alerta Crítica Vencida -->
                            @if (_selectedNovedad.FechaSeguimiento < DateTime.Today && _selectedNovedad.Estado != "Resuelta" && _selectedNovedad.Estado != "Cerrada" && _selectedNovedad.Estado != "Cancelada")
                            {
                                <div class="alert alert-danger bg-danger bg-opacity-10 border-0 text-danger d-flex align-items-center mb-3 py-2 rounded-3 small">
                                    <i class="bi bi-alarm-fill me-2 fs-6"></i>
                                    <div>Esta novedad ha superado la fecha límite de seguimiento asignada sin resolverse.</div>
                                </div>
                            }

                            <!-- Info General -->
                            <div class="mb-3">
                                <span class="badge bg-light text-muted rounded-pill mb-1">ID: @_selectedNovedad.Id</span>
                                <h5 class="fw-bold text-dark mb-1">@_selectedNovedad.Titulo</h5>
                                <p class="text-secondary small mb-2">@_selectedNovedad.Descripcion</p>
                                
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge bg-light text-dark border"><i class="bi bi-tag-fill text-muted me-1"></i>@_selectedNovedad.Categoria</span>
                                    <span class="badge bg-@GetPrioridadColor(_selectedNovedad.Prioridad) bg-opacity-10 text-@GetPrioridadColor(_selectedNovedad.Prioridad)"><i class="bi bi-flag-fill me-1"></i>Prioridad @_selectedNovedad.Prioridad</span>
                                    <span class="badge bg-@GetEstadoColor(_selectedNovedad.Estado) rounded-pill text-white"><i class="bi bi-circle-fill me-1 small"></i>@GetEstadoLabel(_selectedNovedad.Estado)</span>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" title="Anonimización activa aplicada"><i class="bi bi-shield-lock-fill me-1"></i>LOPDP Activa</span>
                                </div>
                            </div>

                            <!-- Asistente de IA (Gemini) -->
                            <div class="card border border-warning bg-warning bg-opacity-5 p-3 rounded-3 mb-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-dark mb-0 small"><i class="bi bi-magic text-warning me-1"></i> Asistente de IA (Gemini)</h6>
                                    @if (_analyzingWithIA)
                                    {
                                        <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
                                    }
                                </div>
                                <p class="text-muted xsmall mb-2">Analiza la descripción en lenguaje natural de la novedad para validar la categoría, prioridad y título óptimos.</p>
                                
                                @if (_analisisResult != null)
                                {
                                    <div class="bg-white p-2 rounded border small mb-2 shadow-sm">
                                        <div class="mb-1"><strong>Título sugerido:</strong> @_analisisResult.TituloSugerido</div>
                                        <div class="mb-1"><strong>Categoría sugerida:</strong> <span class="badge bg-light text-dark border">@_analisisResult.Categoria</span></div>
                                        <div class="mb-1"><strong>Prioridad sugerida:</strong> <span class="badge bg-light text-dark border">@_analisisResult.Prioridad</span></div>
                                        <div class="text-muted xsmall"><strong>Justificación:</strong> @_analisisResult.Justificacion</div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-warning btn-xs px-3 fw-bold text-dark" @onclick="AplicarSugerenciaIAAsync" disabled="@_applyingIA">
                                            @if (_applyingIA)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            Aplicar Sugerencia
                                        </button>
                                        <button class="btn btn-outline-secondary btn-xs" @onclick="() => _analisisResult = null" disabled="@_applyingIA">
                                            Descartar
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-outline-warning btn-sm w-100 fw-bold" @onclick="AnalizarConIAAsync" disabled="@_analyzingWithIA">
                                        <i class="bi bi-cpu-fill me-1"></i> Analizar Descripción con Gemini
                                    </button>
                                }
                            </div>

                            <hr class="text-muted my-3 opacity-25" />

                            <!-- Punto de Venta y Visita -->
                            <div class="mb-3">
                                <h7 class="fw-bold text-dark d-block mb-2">Ubicación y Contexto</h7>
                                <div class="bg-light p-2 rounded-3 small">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <span class="text-muted d-block small">Punto de Venta</span>
                                            <span class="fw-semibold">@GetPdvNombre(_selectedNovedad.PdvId)</span>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted d-block small">ID Visita</span>
                                            <span class="fw-semibold">@_selectedNovedad.VisitaId</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="text-muted my-3 opacity-25" />

                            <!-- Asignación de Responsables (Formulario) -->
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h7 class="fw-bold text-dark mb-0">Asignación de Responsables</h7>
                                    @if (_updatingResponsables)
                                    {
                                        <span class="spinner-border spinner-border-sm text-primary"></span>
                                    }
                                </div>
                                <div class="bg-white p-3 border rounded-3 shadow-sm">
                                    <EditForm Model="_responsablesForm" OnValidSubmit="SaveResponsablesAsync">
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold text-muted mb-1">Responsable Solución</label>
                                            <select class="form-select form-select-sm" @bind="_responsablesForm.ResponsableSolucionId">
                                                @if (_usuarios != null)
                                                {
                                                    @foreach (var u in _usuarios)
                                                    {
                                                        <option value="@u.Id">@u.Nombre @u.Apellido (@u.Rol)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold text-muted mb-1">Responsable Seguimiento</label>
                                            <select class="form-select form-select-sm" @bind="_responsablesForm.ResponsableSeguimientoId">
                                                @if (_usuarios != null)
                                                {
                                                    @foreach (var u in _usuarios)
                                                    {
                                                        <option value="@u.Id">@u.Nombre @u.Apellido (@u.Rol)</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold text-muted mb-1">Fecha Límite Seguimiento</label>
                                            <input type="date" class="form-control form-control-sm" @bind="_responsablesForm.FechaSeguimiento" />
                                        </div>
                                        <button class="btn btn-primary btn-sm w-100" type="submit" disabled="@_updatingResponsables">
                                            <i class="bi bi-save me-1"></i> Guardar Asignaciones
                                        </button>
                                    </EditForm>
                                </div>
                            </div>

                            <hr class="text-muted my-3 opacity-25" />

                            <!-- Flujo y Cambio de Estado -->
                            @if (_selectedNovedad.Estado != "Cerrada")
                            {
                                <div class="mb-4">
                                    <h7 class="fw-bold text-dark d-block mb-2">Acciones de Estado</h7>
                                    <div class="bg-light p-3 rounded-3 border">
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold text-muted mb-1">Nuevo Estado *</label>
                                            <select class="form-select form-select-sm" @bind="_nuevoEstadoSelected">
                                                <option value="">Selecciona un estado...</option>
                                                @foreach (var e in GetEstadosPermitidos(_selectedNovedad.Estado))
                                                {
                                                    <option value="@e">@GetEstadoLabel(e)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                             <label class="form-label small fw-semibold text-muted mb-1">Comentario * (Obligatorio)</label>
                                             <textarea class="form-control form-control-sm" rows="2" placeholder="Especifica el motivo del cambio o información faltante..." @bind="_comentarioEstado"></textarea>
                                             <div class="form-text xsmall text-muted mt-1"><i class="bi bi-shield-fill-check text-success me-1"></i>Gobernanza LOPDP: Este comentario será anonimizado automáticamente al guardarse.</div>
                                         </div>
                                        <button class="btn btn-warning btn-sm w-100 fw-bold" @onclick="ChangeStatusAsync" disabled="@(string.IsNullOrWhiteSpace(_nuevoEstadoSelected) || string.IsNullOrWhiteSpace(_comentarioEstado) || _updatingStatus)">
                                            @if (_updatingStatus)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-arrow-left-right me-1"></i> Aplicar Cambio de Estado
                                        </button>
                                    </div>
                                </div>

                                <hr class="text-muted my-3 opacity-25" />
                            }

                            <!-- Adjuntos e Imágenes -->
                            <div class="mb-4">
                                <h7 class="fw-bold text-dark d-block mb-2">Archivos Adjuntos (Fotos, Videos y Documentos)</h7>
                                @if (!_selectedNovedad.Imagenes.Any())
                                {
                                    <div class="text-center py-3 bg-light rounded-3">
                                        <i class="bi bi-folder-symlink text-muted fs-4 mb-1 d-block"></i>
                                        <span class="text-muted small">No hay archivos registrados para esta novedad.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var img in _selectedNovedad.Imagenes)
                                        {
                                            <div class="col-4">
                                                @if (EsImagen(img.NombreArchivo))
                                                {
                                                    <div class="card border bg-light h-100 overflow-hidden text-center relative-gallery">
                                                        <!-- Imagen Clickable -->
                                                        <img src="@GetImageSrc(img.Id, img.UrlImagen)" class="img-fluid cursor-zoom-in gallery-img" @onclick="() => OpenImageLightbox(img)" alt="@img.NombreArchivo" style="height: 90px; object-fit: cover;" />
                                                        <div class="card-footer p-1 border-0 bg-white d-flex align-items-center justify-content-between">
                                                            <span class="text-muted xsmall text-truncate" style="max-width: 60px;" title="@img.NombreArchivo">@img.NombreArchivo</span>
                                                            <a href="@GetImageSrc(img.Id, img.UrlImagen)" download="@img.NombreArchivo" target="_blank" class="btn btn-link p-0 text-decoration-none text-primary" title="Descargar original">
                                                                <i class="bi bi-download xsmall-icon"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                                else if (EsVideo(img.NombreArchivo))
                                                {
                                                    <div class="card border bg-dark text-white h-100 overflow-hidden text-center relative-gallery cursor-pointer" @onclick="() => OpenVideoLightbox(img)">
                                                        <div class="d-flex flex-column align-items-center justify-content-center bg-black bg-opacity-70" style="height: 90px;">
                                                            <i class="bi bi-play-btn-fill fs-3 text-warning"></i>
                                                            <span class="xsmall text-white opacity-75 mt-1">Video</span>
                                                        </div>
                                                        <div class="card-footer p-1 border-0 bg-secondary bg-opacity-25 d-flex align-items-center justify-content-between">
                                                            <span class="text-white xsmall text-truncate" style="max-width: 60px;" title="@img.NombreArchivo">@img.NombreArchivo</span>
                                                            <a href="@GetImageSrc(img.Id, img.UrlImagen)" download="@img.NombreArchivo" target="_blank" class="btn btn-link p-0 text-decoration-none text-warning" @onclick:stopPropagation="true" title="Descargar video">
                                                                <i class="bi bi-download xsmall-icon"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="card border bg-light h-100 overflow-hidden text-center relative-gallery">
                                                        <div class="d-flex flex-column align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary" style="height: 90px;">
                                                            <i class="bi @(img.NombreArchivo.ToLower().EndsWith(".pdf") ? "bi-file-earmark-pdf-fill text-danger" : "bi-file-earmark-arrow-down-fill text-primary") fs-3"></i>
                                                            <span class="xsmall text-muted mt-1">Documento</span>
                                                        </div>
                                                        <div class="card-footer p-1 border-0 bg-white d-flex align-items-center justify-content-between">
                                                            <span class="text-muted xsmall text-truncate" style="max-width: 60px;" title="@img.NombreArchivo">@img.NombreArchivo</span>
                                                            <a href="@GetImageSrc(img.Id, img.UrlImagen)" download="@img.NombreArchivo" target="_blank" class="btn btn-link p-0 text-decoration-none text-primary" title="Descargar documento">
                                                                <i class="bi bi-download xsmall-icon"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <hr class="text-muted my-3 opacity-25" />

                            <!-- Timeline / Historial -->
                            <div class="mb-3">
                                <h7 class="fw-bold text-dark d-block mb-3">Línea de Tiempo e Historial</h7>
                                <div class="timeline-container ps-3 border-start">
                                    <!-- Registro de Creación -->
                                    <div class="timeline-item position-relative pb-3 mb-1">
                                        <div class="timeline-icon bg-success bg-opacity-20 text-success rounded-circle position-absolute" style="left: -23px; top: 2px; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
                                        </div>
                                        <div class="timeline-content ms-2">
                                            <div class="d-flex justify-content-between">
                                                <span class="fw-bold small text-dark">Novedad Creada</span>
                                                <span class="text-muted xsmall">@_selectedNovedad.CreadoEn.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                            <p class="text-muted xsmall mb-0">Novedad inicializada en estado Abierta.</p>
                                        </div>
                                    </div>

                                    @foreach (var hist in _selectedNovedad.Historial.OrderBy(h => h.CreadoEn))
                                    {
                                        <div class="timeline-item position-relative pb-3 mb-1">
                                            <div class="timeline-icon bg-primary bg-opacity-20 text-primary rounded-circle position-absolute" style="left: -23px; top: 2px; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-arrow-left-right" style="font-size: 9px;"></i>
                                            </div>
                                            <div class="timeline-content ms-2">
                                                <div class="d-flex justify-content-between">
                                                    <span class="fw-bold small text-dark">Cambio a @GetEstadoLabel(hist.EstadoNuevo)</span>
                                                    <span class="text-muted xsmall">@hist.CreadoEn.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                <span class="text-muted xsmall d-block mb-1">Por: @GetUsuarioNombre(hist.UsuarioId)</span>
                                                @if (!string.IsNullOrWhiteSpace(hist.Comentario))
                                                {
                                                    <p class="bg-light p-2 rounded-2 text-dark xsmall mb-0 border">
                                                        <i class="bi bi-chat-text text-muted me-1"></i>@hist.Comentario
                                                    </p>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal / Lightbox de Imagen -->
@if (_activeLightboxImage != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1050;">
