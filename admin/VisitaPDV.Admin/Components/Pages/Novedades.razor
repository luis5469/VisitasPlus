@code {
    [Inject] ApiClient Api { get; set; } = default!;

    // Listas cargadas para selects/mapeos
    private IEnumerable<FarmaciaModel>? _farmacias;
    private IEnumerable<UsuarioModel>? _usuarios;

    // Filtros de búsqueda
    private string _filterEstado = string.Empty;
    private string _filterCategoria = string.Empty;
    private string _filterPrioridad = string.Empty;
    private string _filterPdvId = string.Empty;
    private string _filterResponsableId = string.Empty;
    private DateTime? _filterDesde;
    private DateTime? _filterHasta;

    // Listados de datos
    private NovedadesPagedResponse? _pagedResponse;
    private NovedadModel? _selectedNovedad;
    private NovedadImagenModel? _activeLightboxImage;
    private NovedadImagenModel? _activeLightboxVideo;

    // Variables de carga y estado
    private int _page = 1;
    private int _pageSize = 15;
    private bool _loadingList;
    private bool _loadingDetail;
    private string? _error;
    private string? _listError;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_filterEstado) ||
        !string.IsNullOrWhiteSpace(_filterCategoria) ||
        !string.IsNullOrWhiteSpace(_filterPrioridad) ||
        !string.IsNullOrWhiteSpace(_filterPdvId) ||
        !string.IsNullOrWhiteSpace(_filterResponsableId) ||
        _filterDesde.HasValue ||
        _filterHasta.HasValue;

    // Métricas/Contadores superiores
    private int _cntAbiertas;
    private int _cntEnProgreso;
    private int _cntPendientesInfo;
    private int _cntVencidas;

    // Formulario de asignación de responsables
    private ResponsablesForm _responsablesForm = new();
    private bool _updatingResponsables;

    // Cambio de estado
    private string _nuevoEstadoSelected = string.Empty;
    private string _comentarioEstado = string.Empty;
    private bool _updatingStatus;

    // Variables de IA
    private bool _analyzingWithIA;
    private bool _applyingIA;
    private NovedadAnalisisResult? _analisisResult;

    // Listas de categorías y prioridades estáticas coincidiendo con la App Móvil
    private readonly string[] _categorias = { "Inventario", "Limpieza", "Exhibición", "Precio", "Equipamiento", "Otro" };
    private readonly string[] _prioridades = { "Baja", "Media", "Alta", "Crítica" };

    // URLs SAS de imágenes obtenidas dinámicamente
    private Dictionary<string, string> _cachedImageSasUrls = new();

    protected override async Task OnInitializedAsync()
    {
        _loadingList = true;
        
        // Cargar catálogos de soporte de forma asíncrona
        var farmaciasTask = Api.GetFarmaciasResultAsync();
        var usuariosTask = Api.GetUsuariosResultAsync();

        await Task.WhenAll(farmaciasTask, usuariosTask);

        _farmacias = farmaciasTask.Result.Data;
        _usuarios = usuariosTask.Result.Data;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await LoadContadoresAsync();
        await LoadNovedadesAsync();
    }

    private async Task LoadContadoresAsync()
    {
        // Cargar contadores solicitando a la API (o calculando sobre datos totales locales si no hay endpoints específicos)
        // Por seguridad calculamos usando llamadas paginadas generales o a través de consultas rápidas.
        // Dado que el controlador tiene GET /vencidas, podemos usarlo para la métrica de vencidas.
        // También podemos hacer llamadas filtradas rápidas para las métricas.
        
        var tAbiertas = Api.GetNovedadesResultAsync(estado: "Abierta", tamano: 1);
        var tEnProgreso = Api.GetNovedadesResultAsync(estado: "EnProgreso", tamano: 1);
        var tPendientes = Api.GetNovedadesResultAsync(estado: "PendienteInformacion", tamano: 1);
        var tVencidas = Api.GetNovedadesResultAsync(estado: "Vencida", tamano: 1);

        await Task.WhenAll(tAbiertas, tEnProgreso, tPendientes, tVencidas);

        _cntAbiertas = tAbiertas.Result.Data?.TotalItems ?? 0;
        _cntEnProgreso = tEnProgreso.Result.Data?.TotalItems ?? 0;
        _cntPendientesInfo = tPendientes.Result.Data?.TotalItems ?? 0;
        
        // Para vencidas de forma local también podemos evaluar Novedades vencidas reales desde endpoint /vencidas
        // o si falla sumarle el filtro directo.
        _cntVencidas = tVencidas.Result.Data?.TotalItems ?? 0;
    }

    private async Task LoadNovedadesAsync()
    {
        _loadingList = true;
        _error = null;
        _listError = null;

        var result = await Api.GetNovedadesResultAsync(
            estado: _filterEstado,
            categoria: _filterCategoria,
            prioridad: _filterPrioridad,
            pdvId: _filterPdvId,
            responsableId: _filterResponsableId,
            desde: _filterDesde,
            hasta: _filterHasta,
            pagina: _page,
            tamano: _pageSize
        );

        if (result.Success)
        {
            _pagedResponse = result.Data;
        }
        else
        {
            _listError = result.ErrorMessage ?? "Error desconocido al obtener las novedades.";
        }

        _loadingList = false;
    }

    private async Task SelectNovedadAsync(string id)
    {
        _loadingDetail = true;
        _error = null;
        _selectedNovedad = null;
        _activeLightboxImage = null;
        _activeLightboxVideo = null;
        _nuevoEstadoSelected = string.Empty;
        _comentarioEstado = string.Empty;

        var result = await Api.GetNovedadResultAsync(id);
        if (result.Success && result.Data != null)
        {
            _selectedNovedad = result.Data;
            
            // Inicializar formulario de asignación
            _responsablesForm = new ResponsablesForm
            {
                ResponsableSolucionId = _selectedNovedad.ResponsableSolucionId,
                ResponsableSeguimientoId = _selectedNovedad.ResponsableSeguimientoId,
                FechaSeguimiento = _selectedNovedad.FechaSeguimiento
            };

            // Intentar pre-cargar las SAS URLs de las fotos de forma proactiva
            _cachedImageSasUrls.Clear();
            foreach (var img in _selectedNovedad.Imagenes)
            {
                var sasRes = await Api.GetSasUrlImagenAsync(_selectedNovedad.Id, img.Id);
                if (sasRes.Success && !string.IsNullOrWhiteSpace(sasRes.Data))
                {
                    _cachedImageSasUrls[img.Id] = sasRes.Data;
                }
            }
        }
        else
        {
            _error = result.ErrorMessage ?? $"No se pudo obtener el detalle de la novedad {id}.";
        }

        _loadingDetail = false;
    }

    private async Task SaveResponsablesAsync()
    {
        if (_selectedNovedad == null) return;

        _updatingResponsables = true;
        _error = null;

        var payload = new ActualizarNovedadModel(
            _selectedNovedad.Titulo,
            _selectedNovedad.Descripcion,
            _selectedNovedad.Categoria,
            _selectedNovedad.Prioridad,
            _responsablesForm.ResponsableSolucionId,
            _responsablesForm.ResponsableSeguimientoId,
            _responsablesForm.FechaSeguimiento
        );

        var result = await Api.UpdateNovedadAsync(_selectedNovedad.Id, payload);
        if (result.Success && result.Data != null)
        {
            _selectedNovedad = result.Data;
            await LoadNovedadesAsync(); // Recargar la lista para reflejar cambios
        }
        else
        {
            _error = result.ErrorMessage ?? "Error al actualizar responsables.";
        }

        _updatingResponsables = false;
    }

    private async Task ChangeStatusAsync()
    {
        if (_selectedNovedad == null || string.IsNullOrWhiteSpace(_nuevoEstadoSelected) || string.IsNullOrWhiteSpace(_comentarioEstado)) return;

        _updatingStatus = true;
        _error = null;

        var result = await Api.CambiarEstadoNovedadAsync(_selectedNovedad.Id, _nuevoEstadoSelected, _comentarioEstado);
        if (result.Success && result.Data != null)
        {
            _selectedNovedad = result.Data;
            _nuevoEstadoSelected = string.Empty;
            _comentarioEstado = string.Empty;

            // Recargar listados y contadores
            await LoadContadoresAsync();
            await LoadNovedadesAsync();
        }
        else
        {
            _error = result.ErrorMessage ?? "Error al cambiar el estado.";
        }

        _updatingStatus = false;
    }

    private async Task ClearFiltersAsync()
    {
        _filterEstado = string.Empty;
        _filterCategoria = string.Empty;
        _filterPrioridad = string.Empty;
        _filterPdvId = string.Empty;
        _filterResponsableId = string.Empty;
        _filterDesde = null;
        _filterHasta = null;
        _page = 1;

        await LoadNovedadesAsync();
    }

    private async Task PrevPageAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadNovedadesAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (_pagedResponse != null && _page < _pagedResponse.TotalPaginas)
        {
            _page++;
            await LoadNovedadesAsync();
        }
    }

    private void CloseDetalle()
    {
        _selectedNovedad = null;
        _activeLightboxImage = null;
        _activeLightboxVideo = null;
        _analisisResult = null;
    }

    private async Task AnalizarConIAAsync()
    {
        if (_selectedNovedad == null || string.IsNullOrWhiteSpace(_selectedNovedad.Descripcion)) return;

        _analyzingWithIA = true;
        _error = null;
        _analisisResult = null;

        try
        {
            var result = await Api.AnalizarNovedadConIAAsync(_selectedNovedad.Descripcion);
            if (result.Success && result.Data != null)
            {
                _analisisResult = result.Data;
            }
            else
            {
                _error = result.ErrorMessage ?? "Error al analizar la novedad con IA.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error de comunicación con IA: {ex.Message}";
        }
        finally
        {
            _analyzingWithIA = false;
        }
    }

    private async Task AplicarSugerenciaIAAsync()
    {
        if (_selectedNovedad == null || _analisisResult == null) return;

        _applyingIA = true;
        _error = null;

        var payload = new ActualizarNovedadModel(
            _analisisResult.TituloSugerido,
            _selectedNovedad.Descripcion,
            _analisisResult.Categoria,
            _analisisResult.Prioridad,
            _selectedNovedad.ResponsableSolucionId,
            _selectedNovedad.ResponsableSeguimientoId,
            _selectedNovedad.FechaSeguimiento
        );

        var result = await Api.UpdateNovedadAsync(_selectedNovedad.Id, payload);
        if (result.Success && result.Data != null)
        {
            _selectedNovedad = result.Data;
            _analisisResult = null;
            await LoadNovedadesAsync(); // Recargar la lista
        }
        else
        {
            _error = result.ErrorMessage ?? "Error al aplicar los cambios sugeridos por la IA.";
        }

        _applyingIA = false;
    }

    // Helpers de Mapeo e Interfaz
    private string GetPdvNombre(string pdvId)
    {
        var pdv = _farmacias?.FirstOrDefault(f => f.Id == pdvId || f.Codigo == pdvId);
        return pdv?.Nombre ?? $"Código: {pdvId}";
    }

    private string GetUsuarioNombre(string usuarioId)
    {
        var usr = _usuarios?.FirstOrDefault(u => u.Id == usuarioId || u.Username == usuarioId);
        return usr != null ? $"{usr.Nombre} {usr.Apellido}" : $"ID: {usuarioId}";
    }

    private string GetPrioridadColor(string prioridad)
    {
        return prioridad.ToLower() switch
        {
            "baja" => "secondary",
            "media" => "primary",
            "alta" => "warning",
            "crítica" => "danger",
            _ => "dark"
        };
    }

    private string GetEstadoColor(string estado)
    {
        return estado.ToLower() switch
        {
            "abierta" => "info text-dark",
            "enprogreso" or "en proceso" => "warning text-dark",
            "resuelta" => "success",
            "cerrada" => "secondary",
            "reabierta" => "info",
            "vencida" => "danger",
            "cancelada" => "dark",
            "pendienteinformacion" or "pendiente de subir información" => "danger",
            _ => "dark"
        };
    }

    private string GetEstadoLabel(string estado)
    {
        return estado.ToLower() switch
        {
            "abierta" => "Abierta",
            "enprogreso" or "en proceso" => "En Proceso",
            "resuelta" => "Resuelta",
            "cerrada" => "Cerrada",
            "reabierta" => "Reabierta",
            "vencida" => "Vencida",
            "cancelada" => "Cancelada",
            "pendienteinformacion" or "pendiente de subir información" => "Pendiente Info",
            _ => estado
        };
    }

    private IEnumerable<string> GetEstadosPermitidos(string estadoActual)
    {
        return estadoActual.ToLower() switch
        {
            "abierta" => new[] { "EnProgreso", "Cancelada", "PendienteInformacion" },
            "enprogreso" or "en proceso" => new[] { "Resuelta", "Cancelada" },
            "pendienteinformacion" or "pendiente de subir información" => new[] { "EnProgreso", "Cancelada" },
            "resuelta" => new[] { "Cerrada", "Reabierta" },
            "reabierta" => new[] { "EnProgreso", "Cancelada" },
            _ => Array.Empty<string>()
        };
    }

    private string GetImageSrc(string imagenId, string fallbackUrl)
    {
        // Retornar la URL firmada (SAS) almacenada en caché si está disponible
        if (_cachedImageSasUrls.TryGetValue(imagenId, out var sasUrl))
        {
            return sasUrl;
        }
        return fallbackUrl;
    }

    private void OpenImageLightbox(NovedadImagenModel img)
    {
        _activeLightboxImage = img;
    }

    private void CloseLightbox()
    {
        _activeLightboxImage = null;
    }

    private void OpenVideoLightbox(NovedadImagenModel img)
    {
        _activeLightboxVideo = img;
    }

    private void CloseVideoLightbox()
    {
        _activeLightboxVideo = null;
    }

    private bool EsImagen(string nombreArchivo)
    {
        var ext = System.IO.Path.GetExtension(nombreArchivo).ToLowerInvariant();
        return ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp";
    }

    private bool EsVideo(string nombreArchivo)
    {
        var ext = System.IO.Path.GetExtension(nombreArchivo).ToLowerInvariant();
        return ext == ".mp4" || ext == ".mov" || ext == ".avi" || ext == ".mkv";
    }

    private sealed class ResponsablesForm
    {
        [Required]
        public string ResponsableSolucionId { get; set; } = string.Empty;

        [Required]
        public string ResponsableSeguimientoId { get; set; } = string.Empty;

        [Required]
        public DateTime FechaSeguimiento { get; set; } = DateTime.Today.AddDays(3);
    }
}
