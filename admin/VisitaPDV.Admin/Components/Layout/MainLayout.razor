@inherits LayoutComponentBase

<div class="d-flex" style="min-height:100vh">
    <!-- Sidebar Global -->
    <nav class="d-flex flex-column vpdv-sidebar text-white p-3 shadow" style="width:240px;min-width:240px">
        <div class="mb-4 px-2 pt-2">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary rounded-3 d-flex align-items-center justify-content-center text-white" style="width:36px;height:36px;background-color:var(--color-primary)!important;">
                    <i class="bi bi-clipboard2-pulse fs-5"></i>
                </div>
                <div>
                    <span class="fw-bold fs-6 text-white d-block lh-1">VisitaPDV</span>
                    <span class="text-secondary small" style="font-size:0.75rem;color:#94A3B8!important;">Panel Ejecutivo</span>
                </div>
            </div>
        </div>

        <div class="nav flex-column gap-1">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </NavLink>
            <AuthorizeView Roles="Administrador">
                <NavLink class="nav-link" href="/usuarios">
                    <i class="bi bi-people"></i>
                    <span>Usuarios</span>
                </NavLink>
            </AuthorizeView>
            <NavLink class="nav-link" href="/farmacias">
                <i class="bi bi-shop"></i>
                <span>Puntos de venta</span>
            </NavLink>
            <NavLink class="nav-link" href="/asignaciones">
                <i class="bi bi-calendar-check"></i>
                <span>Agenda de visitas</span>
            </NavLink>
            <NavLink class="nav-link" href="/novedades">
                <i class="bi bi-chat-left-text"></i>
                <span>Novedades</span>
            </NavLink>
            <AuthorizeView Roles="Administrador">
                <div class="my-2 border-top border-secondary border-opacity-25"></div>
                <NavLink class="nav-link" href="/roles">
                    <i class="bi bi-shield-check"></i>
                    <span>Roles</span>
                </NavLink>
                <NavLink class="nav-link" href="/permisos">
                    <i class="bi bi-key"></i>
                    <span>Permisos</span>
                </NavLink>
                <NavLink class="nav-link" href="/auditoria">
                    <i class="bi bi-journal-text"></i>
                    <span>Auditoría</span>
                </NavLink>
            </AuthorizeView>
        </div>

        <div class="mt-auto pt-3 border-top border-secondary border-opacity-25 px-1">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="rounded-circle bg-secondary bg-opacity-25 text-white d-flex align-items-center justify-content-center small fw-bold" style="width:32px;height:32px;">
                            @(context.User.Identity?.Name?.Length > 0 ? context.User.Identity.Name[0].ToString().ToUpperInvariant() : "U")
                        </div>
                        <div class="text-truncate" style="max-width: 140px;">
                            <div class="text-white small fw-semibold text-truncate">@context.User.Identity?.Name</div>
                            <div class="text-secondary" style="font-size:0.7rem;color:#94A3B8!important;">En línea</div>
                        </div>
                    </div>
                    <button class="btn btn-logout btn-sm w-100 d-flex align-items-center justify-content-center gap-2" @onclick="Logout">
                        <i class="bi bi-box-arrow-left"></i>
                        <span>Cerrar sesión</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow-1 p-4 bg-app overflow-auto" style="background-color: var(--color-bg-app);">
        @Body
    </main>
</div>

@code {
    [Inject] ApiClient Api { get; set; } = default!;
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private async Task Logout()
    {
        await Api.LogoutAsync();
        await ((AdminAuthStateProvider)AuthProvider).SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
