@inherits LayoutComponentBase

<div class="d-flex" style="min-height:100vh">
    <!-- Sidebar -->
    <nav class="d-flex flex-column bg-dark text-white p-3" style="width:220px;min-width:220px">
        <div class="mb-4">
            <span class="fw-bold fs-5">&#128203; VisitaPDV</span>
            <div class="text-muted small">Panel Admin</div>
        </div>

        <NavLink class="nav-link text-white mb-1" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </NavLink>
        <AuthorizeView Roles="Administrador">
            <NavLink class="nav-link text-white mb-1" href="/usuarios">
                <i class="bi bi-people me-2"></i> Usuarios
            </NavLink>
        </AuthorizeView>
        <NavLink class="nav-link text-white mb-1" href="/farmacias">
            <i class="bi bi-shop me-2"></i> Farmacias
        </NavLink>
        <NavLink class="nav-link text-white mb-1" href="/asignaciones">
            <i class="bi bi-calendar-check me-2"></i> Asignaciones
        </NavLink>
        <NavLink class="nav-link text-white mb-1" href="/novedades">
            <i class="bi bi-chat-left-text me-2"></i> Novedades
        </NavLink>
        <AuthorizeView Roles="Administrador">
            <NavLink class="nav-link text-white mb-1" href="/roles">
                <i class="bi bi-shield-check me-2"></i> Roles
            </NavLink>
            <NavLink class="nav-link text-white mb-1" href="/permisos">
                <i class="bi bi-key me-2"></i> Permisos
            </NavLink>
            <NavLink class="nav-link text-white mb-1" href="/auditoria">
                <i class="bi bi-journal-text me-2"></i> Auditoría
            </NavLink>
        </AuthorizeView>

        <div class="mt-auto">
            <AuthorizeView>
                <Authorized>
                    <div class="text-muted small mb-1">@context.User.Identity?.Name</div>
                    <button class="btn btn-outline-light btn-sm w-100" @onclick="Logout">
                        <i class="bi bi-box-arrow-left me-1"></i> Salir
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </nav>

    <!-- Main -->
    <main class="flex-grow-1 p-4 bg-light overflow-auto">
        @Body
    </main>
</div>

@code {
    [Inject] ApiClient Api { get; set; } = default!;
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private async Task Logout()
    {
        // Invalida token en el servidor y limpia localStorage + memoria
        await Api.LogoutAsync();
        await ((AdminAuthStateProvider)AuthProvider).SignOutAsync();
        Nav.NavigateTo("/login");
    }
}
