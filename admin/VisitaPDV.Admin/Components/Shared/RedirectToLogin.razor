@* Componente auxiliar: redirige a /login cuando el usuario no está autenticado. *@
@* Se usa en Routes.razor dentro de <NotAuthorized>. *@

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Nav.NavigateTo("/login", replace: true);
    }
}
